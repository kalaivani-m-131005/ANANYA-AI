# ANANYA-AI — Frontend Environment Configuration
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.

# ── Frontend API URL ──────────────────────────────────────────
# Points to the backend REST API server.
# This is the ONLY variable safe to expose to the frontend (VITE_ prefix).
VITE_API_URL=http://localhost:5000/api

# ── IMPORTANT ─────────────────────────────────────────────────
# Backend-only secrets (NEVER put these in the frontend .env):
#   GEMINI_API_KEY     — Gemini AI API key       (backend only)
#   JWT_SECRET         — JWT signing secret       (backend only)
#   MONGODB_URI        — Database connection URL  (backend only)
#   SESSION_SECRET     — Session secret           (backend only)
# These will be added to server/.env.example in Phase 3.
